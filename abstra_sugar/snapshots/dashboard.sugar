# === COMPONENTS ===

card = (title):
 .bg-gray-900.rounded-2xl.border.border-gray-800:
  .flex.items-center.justify-between.p-6.border-b.border-gray-800:
   h3.font-semibold.text-lg: {title}
   slot:

panel = ():
 .bg-gray-900.rounded-2xl.border.border-gray-800.p-6:
  slot:

modal = (id, title):
 .fixed.inset-0.modal-backdrop.z-50.hidden.items-center.justify-center id=modal-{id}:
  .bg-gray-900.rounded-2xl.border.border-gray-800.w-full.max-w-lg.fade-in:
   .flex.items-center.justify-between.p-6.border-b.border-gray-800:
    h3.font-semibold.text-lg: {title}
    button.text-gray-400.hover:text-white.text-2xl.leading-none onclick=closeModal('{id}'): &times;
   .p-6.space-y-4:
    slot:
   .flex.justify-end.gap-3.p-6.border-t.border-gray-800 id=modal-{id}-actions:

field = (label, id, type, placeholder):
 div:
  label.block.text-sm.text-gray-400.mb-1: {label}
  input.w-full.bg-gray-800.border.border-gray-700.rounded-lg.px-4.py-2.5.text-sm.focus:border-primary.focus:outline-none type={type} placeholder={placeholder} id={id}:

selectfield = (label, id):
 div:
  label.block.text-sm.text-gray-400.mb-1: {label}
  select.w-full.bg-gray-800.border.border-gray-700.rounded-lg.px-4.py-2.5.text-sm.focus:border-primary.focus:outline-none id={id}:
   slot:

navlink = (icon, label):
 a.flex.items-center.gap-3.px-4.py-2.5.rounded-lg.text-gray-400.hover:bg-gray-800.hover:text-white.transition href=#:
  span: {icon}
  span: {label}

filterbtn = (label):
 button.px-3.py-1.5.text-xs.rounded-lg.text-gray-400.hover:bg-gray-800.transition: {label}

# === PAGE ===

html lang=en:
 head:
  meta charset=UTF-8:
  meta name=viewport content=width=device-width,initial-scale=1.0:
  title: Finance Dashboard
  script src=https://cdn.tailwindcss.com:
  script:
   tailwind.config = theme:
    extend:
     colors:
      primary: "#6366f1"
      accent: "#22d3ee"
      danger: "#ef4444"
      success: "#10b981"
      warn: "#f59e0b"
  style:
   body:
    font-family: Inter, system-ui, sans-serif
   .modal-backdrop:
    background: rgba(0, 0, 0, 0.5)
    backdrop-filter: blur(4px)
   .fade-in:
    animation: fadeIn 0.2s ease-out
   @keyframes fadeIn:
    from:
     opacity: 0
     transform: scale(0.95)
    to:
     opacity: 1
     transform: scale(1)
   .slide-in:
    animation: slideIn 0.3s ease-out
   @keyframes slideIn:
    from:
     transform: translateX(100%)
    to:
     transform: translateX(0)
   ::-webkit-scrollbar:
    width: 6px
   ::-webkit-scrollbar-thumb:
    background: #374151
    border-radius: 3px

 body.bg-gray-950.text-white.min-h-screen:
  # Sidebar
  .fixed.inset-y-0.left-0.w-64.bg-gray-900.border-r.border-gray-800.flex.flex-col.z-30 id=sidebar:
   .p-6.border-b.border-gray-800:
    .flex.items-center.gap-3:
     .w-10.h-10.bg-primary.rounded-xl.flex.items-center.justify-center.text-lg.font-bold: F
     div:
      .font-bold.text-lg: FinDash
      .text-xs.text-gray-400: Pro Edition
   nav.flex-1.p-4.space-y-1:
    a.flex.items-center.gap-3.px-4.py-2.5.rounded-lg.bg-primary.bg-opacity-20.text-primary.font-medium href=#:
     span: &#9632;
     span: Dashboard
    navlink("&#9650;", "Analytics")
    navlink("&#9660;", "Transactions")
    navlink("&#9670;", "Investments")
    navlink("&#9672;", "Budget")
    navlink("&#9881;", "Settings")
   .p-4.border-t.border-gray-800:
    .flex.items-center.gap-3.px-2:
     .w-8.h-8.rounded-full.bg-gradient-to-br.from-primary.to-accent.flex.items-center.justify-center.text-sm.font-bold: JD
     .flex-1.min-w-0:
      .text-sm.font-medium.truncate: John Doe
      .text-xs.text-gray-400: Premium Plan

  # Main content
  .ml-64.flex.flex-col.min-h-screen:
   # Top bar
   header.sticky.top-0.bg-gray-950.bg-opacity-80.backdrop-blur-lg.border-b.border-gray-800.z-20:
    .flex.items-center.justify-between.px-8.py-4:
     div:
      h1.text-2xl.font-bold: Dashboard
      p.text-sm.text-gray-400: Welcome back, John. Here's your financial overview.
     .flex.items-center.gap-4:
      .relative:
       input.bg-gray-800.text-sm.rounded-lg.pl-10.pr-4.py-2.w-64.border.border-gray-700.focus:border-primary.focus:outline-none.transition placeholder=Search... type=text:
       span.absolute.left-3.top-2.text-gray-400: &#128269;
      button.relative.p-2.rounded-lg.hover:bg-gray-800.transition onclick=toggleNotifications():
       span.text-xl: &#128276;
       span.absolute.top-1.right-1.w-2.h-2.bg-danger.rounded-full:
      button.px-4.py-2.bg-primary.rounded-lg.text-sm.font-medium.hover:bg-opacity-80.transition onclick=openModal('addTransaction'): + New Transaction

   # Content area
   main.flex-1.p-8:
    # KPI Cards
    .grid.grid-cols-4.gap-6.mb-8 id=kpi-cards:

    # Charts row
    .grid.grid-cols-3.gap-6.mb-8:
     .col-span-2:
      panel():
       .flex.items-center.justify-between.mb-6:
        div:
         h3.font-semibold.text-lg: Revenue Overview
         p.text-sm.text-gray-400: Monthly revenue and expenses
        .flex.gap-2:
         button.px-3.py-1.text-xs.rounded-lg.bg-primary.bg-opacity-20.text-primary.font-medium: 1Y
         filterbtn("6M")
         filterbtn("1M")
       canvas#revenueChart height=300:

     panel():
      h3.font-semibold.text-lg.mb-2: Spending Categories
      p.text-sm.text-gray-400.mb-6: This month's breakdown
      canvas#donutChart height=200:
      .mt-4.space-y-2 id=donut-legend:

    # Transactions and activity
    .grid.grid-cols-3.gap-6.mb-8:
     .col-span-2:
      card("Recent Transactions"):
       .flex.gap-2:
        button.px-3.py-1.5.text-xs.rounded-lg.bg-gray-800.text-white.font-medium: All
        filterbtn("Income")
        filterbtn("Expense")
      #transactions-list:

     card("Activity Feed"):
     .p-4.space-y-4.max-h-96.overflow-y-auto id=activity-feed:

    # Investment portfolio
    card("Investment Portfolio"):
     button.px-4.py-2.text-sm.bg-gray-800.rounded-lg.hover:bg-gray-700.transition onclick=openModal('addInvestment'): + Add Position
    .overflow-x-auto:
     table.w-full:
      thead:
       tr.text-left.text-xs.text-gray-400.uppercase:
        .px-6.py-4: Asset
        .px-6.py-4: Shares
        .px-6.py-4: Avg Cost
        .px-6.py-4: Current
        .px-6.py-4: P&L
        .px-6.py-4: Allocation
        .px-6.py-4: Actions
      tbody id=portfolio-body:

    # Budget section
    card("Monthly Budget"):
     p.text-sm.text-gray-400: March 2026
    .p-6.grid.grid-cols-2.gap-6 id=budget-bars:

  # Modals
  modal("addTransaction", "New Transaction"):
   field("Description", "tx-desc", "text", "Enter description")
   .grid.grid-cols-2.gap-4:
    field("Amount", "tx-amount", "number", "0.00")
    selectfield("Type", "tx-type"):
     value=income: Income
     option value=expense: Expense
   selectfield("Category", "tx-category"):
    : Salary
    option: Food & Dining
    option: Shopping
    option: Transportation
    option: Entertainment
    option: Bills & Utilities
    option: Healthcare
    option: Investment
   field("Date", "tx-date", "date", "")
   div:
    label.block.text-sm.text-gray-400.mb-1: Notes
    textarea.w-full.bg-gray-800.border.border-gray-700.rounded-lg.px-4.py-2.5.text-sm.focus:border-primary.focus:outline-none.resize-none rows=2 placeholder=Optional\ notes id=tx-notes:

  modal("addInvestment", "Add Investment"):
   .grid.grid-cols-2.gap-4:
    field("Ticker", "inv-ticker", "text", "AAPL")
    field("Shares", "inv-shares", "number", "0")
   .grid.grid-cols-2.gap-4:
    field("Buy Price", "inv-price", "number", "0.00")
    field("Date", "inv-date", "date", "")

  # Detail slide-over
  .fixed.inset-0.modal-backdrop.z-50.hidden id=modal-detail:
   .absolute.right-0.top-0.h-full.w-full.max-w-md.bg-gray-900.border-l.border-gray-800.slide-in:
    .flex.items-center.justify-between.p-6.border-b.border-gray-800:
     h3.font-semibold.text-lg: Transaction Detail
     button.text-gray-400.hover:text-white.text-2xl.leading-none onclick=closeModal('detail'): &times;
    .p-6.space-y-6 id=detail-content:

  # Notifications panel
  .fixed.top-16.right-8.w-80.bg-gray-900.rounded-2xl.border.border-gray-800.shadow-2xl.z-50.hidden id=notifications-panel:
   .p-4.border-b.border-gray-800.flex.items-center.justify-between:
    h3.font-semibold: Notifications
    button.text-xs.text-primary.hover:underline onclick=clearNotifications(): Clear all
   .max-h-96.overflow-y-auto id=notifications-list:

  # Confirm delete modal
  .fixed.inset-0.modal-backdrop.z-50.hidden.items-center.justify-center id=modal-confirmDelete:
   .bg-gray-900.rounded-2xl.border.border-gray-800.w-full.max-w-sm.fade-in:
    .p-6.text-center:
     .w-12.h-12.rounded-full.bg-danger.bg-opacity-20.flex.items-center.justify-center.mx-auto.mb-4:
      span.text-danger.text-2xl: !
     h3.font-semibold.text-lg.mb-2: Confirm Delete
     p.text-sm.text-gray-400: Are you sure? This action cannot be undone.
    .flex.gap-3.p-6.pt-0:
     button.flex-1.px-4.py-2.text-sm.rounded-lg.bg-gray-800.hover:bg-gray-700.transition onclick=closeModal('confirmDelete'): Cancel
     button.flex-1.px-4.py-2.text-sm.rounded-lg.bg-danger.hover:bg-opacity-80.font-medium.transition onclick=confirmDelete(): Delete

  # Toast container
  .fixed.bottom-6.right-6.space-y-3.z-50 id=toast-container:

  script:
   # === DATA ===
   state =:
    transactions: []
    investments: []
    notifications: []
    deleteTarget: null
    selectedTx: null

   categories =:
    Salary:
     color: "#6366f1"
     icon: "&#128176;"
    "Food & Dining":
     color: "#f59e0b"
     icon: "&#127869;"
    Shopping:
     color: "#ec4899"
     icon: "&#128722;"
    Transportation:
     color: "#22d3ee"
     icon: "&#128663;"
    Entertainment:
     color: "#a855f7"
     icon: "&#127916;"
    "Bills & Utilities":
     color: "#ef4444"
     icon: "&#9889;"
    Healthcare:
     color: "#10b981"
     icon: "&#128138;"
    Investment:
     color: "#14b8a6"
     icon: "&#128200;"

   # Seed data
   seedData():
    now = new Date()
    txs = table!:
     desc                | amount | type      | category            | date         | notes
     "Salary Deposit"    | 8500   | "income"  | "Salary"            | "2026-03-01" | "Monthly salary"
     "Grocery Store"     | 234.50 | "expense" | "Food & Dining"     | "2026-03-03" |
     "Electric Bill"     | 145.00 | "expense" | "Bills & Utilities" | "2026-03-05" |
     "Netflix"           | 15.99  | "expense" | "Entertainment"     | "2026-03-05" |
     "Gas Station"       | 55.00  | "expense" | "Transportation"    | "2026-03-07" |
     "Freelance Payment" | 2200   | "income"  | "Salary"            | "2026-03-10" |
     "Restaurant"        | 78.50  | "expense" | "Food & Dining"     | "2026-03-12" |
     "Pharmacy"          | 42.00  | "expense" | "Healthcare"        | "2026-03-14" |
     "New Shoes"         | 129.99 | "expense" | "Shopping"          | "2026-03-15" |
     "ETF Purchase"      | 500    | "expense" | "Investment"        | "2026-03-18" |
     "Uber Ride"         | 23.50  | "expense" | "Transportation"    | "2026-03-19" |
     "Concert Tickets"   | 180    | "expense" | "Entertainment"     | "2026-03-20" |
    for tx of txs:
     tx.id = Math.random().toString(36).substr(2, 9)
    state.transactions = txs

    state.investments = table!:
     ticker  | name               | shares | avgCost | current | change
     "AAPL"  | "Apple Inc."       | 25     | 178.50  | 195.20  | 1.8
     "MSFT"  | "Microsoft"        | 15     | 380.00  | 415.75  | -0.5
     "GOOGL" | "Alphabet"         | 10     | 140.25  | 158.90  | 2.3
     "AMZN"  | "Amazon"           | 20     | 175.00  | 188.40  | 0.9
     "VOO"   | "Vanguard S&P 500" | 30     | 420.00  | 445.60  | 0.4
    state.notifications = table!:
     text                                 | time     | unread
     "Salary deposited: $8,500.00"        | "2h ago" | true
     "Budget alert: Food & Dining at 85%" | "5h ago" | true
     "Investment +2.3% GOOGL"             | "1d ago" | false
     "Bill reminder: Rent due in 3 days"  | "1d ago" | false
   # === UTILITY ===
   fmt(n):
    return n.toLocaleString("en-US", {style: "currency", currency: "USD"})

   pct(n):
    return (n >= 0 ? "+" : "") + n.toFixed(1) + "%"

   toast(msg, type):
    container = document.getElementById("toast-container")
    colors =:
     success: "bg-success"
     error: "bg-danger"
     info: "bg-primary"
    div = document.createElement("div")
    div.className = `${colors[type] || "bg-gray-700"} text-white px-4 py-3 rounded-lg shadow-lg text-sm fade-in flex items-center gap-2`
    div.innerHTML = msg
    container.appendChild(div)
    setTimeout((): container.removeChild(div), 3000)

   # === MODALS ===
   openModal(name):
    el = document.getElementById("modal-" + name)
    el.classList.remove("hidden")
    el.classList.add("flex")

   closeModal(name):
    el = document.getElementById("modal-" + name)
    el.classList.add("hidden")
    el.classList.remove("flex")

   toggleNotifications():
    panel = document.getElementById("notifications-panel")
    panel.classList.toggle("hidden")

   clearNotifications():
    state.notifications = []
    renderNotifications()
    toast("Notifications cleared", "info")

   # === SUBMIT HANDLERS ===
   submitTransaction():
    desc = document.getElementById("tx-desc").value
    amount = parseFloat(document.getElementById("tx-amount").value)
    type = document.getElementById("tx-type").value
    category = document.getElementById("tx-category").value
    date = document.getElementById("tx-date").value
    notes = document.getElementById("tx-notes").value

    if !desc || isNaN(amount) || !date:
     toast("Please fill required fields", "error")
     return

    tx =:
     id: Math.random().toString(36).substr(2, 9)
     desc: desc
     amount: amount
     type: type
     category: category
     date: date
     notes: notes
    state.transactions.unshift(tx)
    closeModal("addTransaction")
    document.getElementById("tx-desc").value = ""
    document.getElementById("tx-amount").value = ""
    document.getElementById("tx-notes").value = ""
    renderAll()
    toast("Transaction added successfully", "success")

   submitInvestment():
    ticker = document.getElementById("inv-ticker").value.toUpperCase()
    shares = parseInt(document.getElementById("inv-shares").value)
    price = parseFloat(document.getElementById("inv-price").value)

    if !ticker || isNaN(shares) || isNaN(price):
     toast("Please fill all fields", "error")
     return

    state.investments.push({ticker: ticker, name: ticker, shares: shares, avgCost: price, current: price * (1 + (Math.random() - 0.5) * 0.1), change: (Math.random() - 0.5) * 5})
    closeModal("addInvestment")
    renderAll()
    toast(`Added ${ticker} to portfolio`, "success")

   # === DELETE ===
   requestDelete(id):
    state.deleteTarget = id
    openModal("confirmDelete")

   confirmDelete():
    if state.deleteTarget:
     state.transactions = state.transactions.filter((t): t.id !== state.deleteTarget)
     state.deleteTarget = null
     closeModal("confirmDelete")
     renderAll()
     toast("Transaction deleted", "info")

   # === DETAIL VIEW ===
   showDetail(id):
    tx = state.transactions.find((t): t.id === id)
    if !tx:
     return
    cat = categories[tx.category] || {color: "#6b7280", icon: "&#9679;"}
    content = document.getElementById("detail-content")
    content.innerHTML = html!:
     .flex.items-center.gap-4.mb-6:
      .w-14.h-14.rounded-2xl.flex.items-center.justify-center.text-2xl: {cat.icon}
      div:
       .font-semibold.text-lg: {tx.desc}
       .text-sm.text-gray-400: {tx.category}
     .grid.grid-cols-2.gap-4:
      .bg-gray-800.rounded-xl.p-4:
       .text-xs.text-gray-400.mb-1: Amount
       .font-semibold: {fmt(tx.amount)}
      .bg-gray-800.rounded-xl.p-4:
       .text-xs.text-gray-400.mb-1: Date
       .font-semibold: {tx.date}
      .bg-gray-800.rounded-xl.p-4:
       .text-xs.text-gray-400.mb-1: Type
       .font-semibold.capitalize: {tx.type}
      .bg-gray-800.rounded-xl.p-4:
       .text-xs.text-gray-400.mb-1: Category
       .font-semibold: {tx.category}
    openModal("detail")

   # === RENDER FUNCTIONS ===
   renderKPIs():
    income = state.transactions.filter((t): t.type === "income").reduce((s, t): s + t.amount, 0)
    expenses = state.transactions.filter((t): t.type === "expense").reduce((s, t): s + t.amount, 0)
    balance = income - expenses
    investmentValue = state.investments.reduce((s, i): s + i.current * i.shares, 0)

    cards = table!:
     label           | value                | change   | color     | icon
     "Total Balance" | fmt(balance)         | "+12.5%" | "primary" | "&#128179;"
     "Income"        | fmt(income)          | "+8.2%"  | "success" | "&#128200;"
     "Expenses"      | fmt(expenses)        | "-3.1%"  | "danger"  | "&#128201;"
     "Investments"   | fmt(investmentValue) | "+5.7%"  | "accent"  | "&#128176;"
    container = document.getElementById("kpi-cards")
    container.innerHTML = ""
    for card of cards:
     isPositive = card.change.startsWith("+")
     container.innerHTML += html!:
      .bg-gray-900.rounded-2xl.border.border-gray-800.p-6.hover:border-gray-700.transition.cursor-pointer:
       .flex.items-center.justify-between.mb-4:
        .text-2xl: {card.icon}
        span.text-xs.font-medium.px-2.py-1.rounded-full: {card.change}
       .text-2xl.font-bold.mb-1: {card.value}
       .text-sm.text-gray-400: {card.label}

   renderTransactions():
    container = document.getElementById("transactions-list")
    container.innerHTML = ""
    sorted = [...state.transactions].sort((a, b): new Date(b.date) - new Date(a.date))
    for tx of sorted.slice(0, 10):
     cat = categories[tx.category] || {color: "#6b7280", icon: "&#9679;"}
     isIncome = tx.type === "income"
     container.innerHTML += html!:
      .flex.items-center.gap-4.px-6.py-4.hover:bg-gray-800/50.transition.cursor-pointer.border-b.border-gray-800/50:
       .w-10.h-10.rounded-xl.flex.items-center.justify-center: {cat.icon}
       .flex-1.min-w-0:
        .font-medium.text-sm: {tx.desc}
        .text-xs.text-gray-400: {tx.category} &middot; {tx.date}
       .text-right:
        .font-semibold.text-sm: {fmt(tx.amount)}

   renderPortfolio():
    container = document.getElementById("portfolio-body")
    container.innerHTML = ""
    totalValue = state.investments.reduce((s, i): s + i.current * i.shares, 0)
    for inv of state.investments:
     pl = (inv.current - inv.avgCost) * inv.shares
     plPct = ((inv.current - inv.avgCost) / inv.avgCost) * 100
     alloc = (inv.current * inv.shares / totalValue * 100).toFixed(1)
     isUp = pl >= 0
     container.innerHTML += html!:
      tr.border-b.border-gray-800/50.hover:bg-gray-800/30.transition:
       td.px-6.py-4:
        .font-medium: {inv.ticker}
        .text-xs.text-gray-400: {inv.name}
       td.px-6.py-4: {inv.shares}
       td.px-6.py-4: {fmt(inv.avgCost)}
       td.px-6.py-4:
        div: {fmt(inv.current)}
        .text-xs: {pct(inv.change)} today
       td.px-6.py-4: {fmt(pl)}
       td.px-6.py-4:
        .flex.items-center.gap-2:
         .flex-1.bg-gray-700.rounded-full.h-1:
          .bg-primary.rounded-full.h-1:
         span.text-xs.text-gray-400: {alloc}%
       td.px-6.py-4:
        button.text-xs.text-primary.hover:underline: Trade

   renderBudget():
    container = document.getElementById("budget-bars")
    container.innerHTML = ""
    budgets = table!:
     name                | limit
     "Food & Dining"     | 400
     "Transportation"    | 200
     "Entertainment"     | 250
     "Shopping"          | 300
     "Bills & Utilities" | 500
     "Healthcare"        | 150
    for b of budgets:
     spent = state.transactions.filter((t): t.category === b.name && t.type === "expense").reduce((s, t): s + t.amount, 0)
     pctUsed = Math.min((spent / b.limit * 100), 100).toFixed(0)
     color = pctUsed > 90 ? "#ef4444" : pctUsed > 70 ? "#f59e0b" : "#10b981"
     container.innerHTML += html!:
      div:
       .flex.justify-between.text-sm.mb-2:
        span: {b.name}
        span.text-gray-400: {fmt(spent)} / {fmt(b.limit)}
       .w-full.bg-gray-800.rounded-full.h-2:
        .h-2.rounded-full.transition-all:

   renderActivity():
    container = document.getElementById("activity-feed")
    container.innerHTML = ""
    activities = [...state.transactions].sort((a, b): new Date(b.date) - new Date(a.date)).slice(0, 8)
    for tx of activities:
     cat = categories[tx.category] || {color: "#6b7280", icon: "&#9679;"}
     container.innerHTML += html!:
      .flex.gap-3:
       .w-8.h-8.rounded-lg.flex.items-center.justify-center.text-sm: {cat.icon}
       .flex-1:
        .text-sm: {tx.desc}
        .text-xs.text-gray-400: {tx.date}
       .text-xs.font-medium: {fmt(tx.amount)}

   renderNotifications():
    container = document.getElementById("notifications-list")
    container.innerHTML = ""
    if state.notifications.length === 0:
     container.innerHTML = '<div class="p-6 text-center text-sm text-gray-400">No notifications</div>'
     return
    for n of state.notifications:
     container.innerHTML += html!:
      .px-4.py-3.border-b.border-gray-800/50.hover:bg-gray-800/30.transition:
       .text-sm: {n.text}
       .text-xs.text-gray-400.mt-1: {n.time}

   # === CHARTS ===
   drawRevenueChart():
    canvas = document.getElementById("revenueChart")
    ctx = canvas.getContext("2d")
    w = canvas.width = canvas.parentElement.clientWidth - 48
    h = canvas.height = 300

    months =:
     "Jan"
     "Feb"
     "Mar"
     "Apr"
     "May"
     "Jun"
     "Jul"
     "Aug"
     "Sep"
     "Oct"
     "Nov"
     "Dec"
    revenue =:
     4200
     5100
     4800
     6200
     5800
     7100
     6500
     7800
     8200
     7600
     8500
     10700
    expenses =:
     3100
     3800
     3500
     4100
     4300
     4800
     4200
     5100
     5400
     4900
     5200
     6800
    maxVal = Math.max(...revenue) * 1.1
    barW = (w - 80) / months.length
    padL = 60
    padB = 40

    ctx.clearRect(0, 0, w, h)

    # Grid lines
    for i of [0, 1, 2, 3, 4]:
     y = (h - padB) - (i / 4) * (h - padB - 20)
     ctx.strokeStyle = "#1f2937"
     ctx.lineWidth = 1
     ctx.beginPath()
     ctx.moveTo(padL, y)
     ctx.lineTo(w, y)
     ctx.stroke()
     ctx.fillStyle = "#6b7280"
     ctx.font = "11px monospace"
     ctx.textAlign = "right"
     ctx.fillText("$" + Math.round(maxVal * i / 4 / 1000) + "k", padL - 8, y + 4)

    for i of Array.from({length: months.length}, (_, i): i):
     x = padL + i * barW + barW * 0.15
     bw = barW * 0.3

     # Revenue bar
     rh = (revenue[i] / maxVal) * (h - padB - 20)
     ctx.fillStyle = "#6366f1"
     ctx.beginPath()
     ctx.roundRect(x, h - padB - rh, bw, rh, [4, 4, 0, 0])
     ctx.fill()

     # Expense bar
     eh = (expenses[i] / maxVal) * (h - padB - 20)
     ctx.fillStyle = "#22d3ee"
     ctx.beginPath()
     ctx.roundRect(x + bw + 2, h - padB - eh, bw, eh, [4, 4, 0, 0])
     ctx.fill()

     # Month label
     ctx.fillStyle = "#6b7280"
     ctx.font = "11px monospace"
     ctx.textAlign = "center"
     ctx.fillText(months[i], padL + i * barW + barW / 2, h - 12)

    # Legend
    ctx.fillStyle = "#6366f1"
    ctx.fillRect(w - 180, 8, 12, 12)
    ctx.fillStyle = "#9ca3af"
    ctx.font = "12px sans-serif"
    ctx.textAlign = "left"
    ctx.fillText("Revenue", w - 162, 18)
    ctx.fillStyle = "#22d3ee"
    ctx.fillRect(w - 90, 8, 12, 12)
    ctx.fillStyle = "#9ca3af"
    ctx.fillText("Expenses", w - 72, 18)

   drawDonutChart():
    canvas = document.getElementById("donutChart")
    ctx = canvas.getContext("2d")
    w = canvas.width = canvas.parentElement.clientWidth - 48
    h = canvas.height = 200
    cx = w / 2
    cy = h / 2
    outerR = Math.min(cx, cy) - 10
    innerR = outerR * 0.6

    # Aggregate spending by category
    spending = {}
    for tx of state.transactions:
     if tx.type === "expense":
      if !spending[tx.category]:
       spending[tx.category] = 0
      spending[tx.category] += tx.amount

    entries = Object.entries(spending).sort((a, b): b[1] - a[1])
    total = entries.reduce((s, e): s + e[1], 0)

    ctx.clearRect(0, 0, w, h)

    startAngle = -Math.PI / 2
    for entry of entries:
     cat = categories[entry[0]] || {color: "#6b7280"}
     sliceAngle = (entry[1] / total) * Math.PI * 2
     ctx.beginPath()
     ctx.arc(cx, cy, outerR, startAngle, startAngle + sliceAngle)
     ctx.arc(cx, cy, innerR, startAngle + sliceAngle, startAngle, true)
     ctx.closePath()
     ctx.fillStyle = cat.color
     ctx.fill()
     startAngle += sliceAngle

    # Center text
    ctx.fillStyle = "#fff"
    ctx.font = "bold 18px sans-serif"
    ctx.textAlign = "center"
    ctx.fillText(fmt(total), cx, cy + 2)
    ctx.fillStyle = "#9ca3af"
    ctx.font = "11px sans-serif"
    ctx.fillText("Total Spent", cx, cy + 18)

    # Legend
    legend = document.getElementById("donut-legend")
    legend.innerHTML = ""
    for entry of entries:
     cat = categories[entry[0]] || {color: "#6b7280"}
     p = (entry[1] / total * 100).toFixed(0)
     legend.innerHTML += html!:
      .flex.items-center.justify-between.text-sm:
       .flex.items-center.gap-2:
        .w-3.h-3.rounded-full:
        span.text-gray-300: {entry[0]}
       span.text-gray-400: {p}%

   # === RENDER ALL ===
   renderAll():
    renderKPIs()
    renderTransactions()
    renderPortfolio()
    renderBudget()
    renderActivity()
    renderNotifications()
    drawRevenueChart()
    drawDonutChart()

   # === INIT ===
   seedData()
   renderAll()

   window.addEventListener("resize", ():
    drawRevenueChart()
    drawDonutChart()
   )

   # Close modals on backdrop click
   document.querySelectorAll("[id^=modal-]").forEach(
    (modal):
     modal.addEventListener("click", (e):
      if e.target === modal:
       modal.classList.add("hidden")
       modal.classList.remove("flex")
     )
   )
