html:
 head:
  style:
   # Comments using '# '
   .table-header:
    font-weight: bold
 body:
  h1: Users
  # Empty tags have no children
  hr:
  table:
   thead.table-header:
    : id
    : nome
    : email
    : link
   tbody:
    # This is another comment
    tr onmouseover=mousehover(this) :
     : 1
     : foo
     : foo@company.com
     : a href=/users/1: Edit User
    tr:
     : 2
     : bar
     : bar@co.com
     : a href=/users/2: Edit User
 script module:
  mousehover(t):
   console.log(t)

  async logAfter(txt, time):
   await new Promise(
    (res):
     setTimeout((): console.log(txt), time)
   )

  # This is a comment
  for x of [1, 2, 3]:
   if x % 2 == 0:
    console.log(x)

  class User:
   constructor(dto):
    this.name = dto.name
    this.id = dto.id
    this.email = dto.email

   say():
    logAfter(`Hi! My name is ${this.name}`, 5000)

   async fromId(id):
    res = await fetch(`/api/users/${id}`)
    dto = await res.json()
    return new User(dto)
