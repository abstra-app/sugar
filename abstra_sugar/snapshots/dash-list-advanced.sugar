html:
 body:
  script:
   # Simple values
   primes =:
    2
    3
    5
    7

   # Objects with many fields
   employees =:
    :
     name: "Alice"
     dept: "Engineering"
     level: 5
     active: true
    :
     name: "Bob"
     dept: "Design"
     level: 3
     active: false

   # Single item
   admins =:
    :
     name: "root"
     sudo: true

   console.log(primes, employees, admins)
